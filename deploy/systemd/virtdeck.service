[Unit]
Description=VirtDeck API server
After=network.target libvirtd.service
Requires=libvirtd.service

[Service]
Type=simple
User=virtdeck
Group=libvirt
WorkingDirectory=/opt/virtdeck/backend
EnvironmentFile=/etc/virtdeck/virtdeck.env
ExecStart=/opt/virtdeck/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/libvirt/images

[Install]
WantedBy=multi-user.target
